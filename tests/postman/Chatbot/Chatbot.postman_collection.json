              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/history/{{emptyUserId}}?limit=10",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "history",
                "{{emptyUserId}}"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "BOT-API-04 History",
      "item": [
        {
          "name": "BOT-API-04 History",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code >= 400) { console.log('RESPONSE BODY: ' + pm.response.text()); }",
                  "const rows = pm.response.json();",
                  "pm.test('BOT-API-04 status code is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('BOT-API-04 response is an array', function () {",
                  "  pm.expect(rows).to.be.an('array').and.not.empty;",
                  "});",
                  "pm.test('BOT-API-04 contains the user message that was sent', function () {",
                  "  const userRows = rows.filter(r => r.role === 'user');",
                  "  pm.expect(userRows.length).to.be.at.least(1);",
                  "  pm.expect(userRows.map(r => r.content)).to.include('Toi bi dau rang sau');",
                  "});",
                  "pm.test('BOT-API-04 contains a non-empty bot message', function () {",
                  "  const botRows = rows.filter(r => r.role === 'bot');",
                  "  pm.expect(botRows.length).to.be.at.least(1);",
                  "  pm.expect(botRows[0].content).to.be.a('string').and.not.empty;",
                  "});",
                  "pm.test('BOT-API-04 every record has id and valid timestamp', function () {",
                  "  rows.forEach(function (r) {",
                  "    pm.expect(r.id).to.be.a('string').and.not.empty;",
                  "    pm.expect(isNaN(Date.parse(r.timestamp))).to.be.false;",
                  "  });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/history/{{userId}}?limit=10",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "history",
                "{{userId}}"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            }
          }
        }
      ]
    }
  ]
}