        },
        {
          "name": "BOT-API-03 Check history recorded",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "setTimeout(function () {}, 1000);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code >= 400) { console.log('RESPONSE BODY: ' + pm.response.text()); }",
                  "pm.test('BOT-API-03 history status code is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('BOT-API-03 history is recorded for the empty message user', function () {",
                  "  const rows = pm.response.json();",
                  "  pm.expect(rows).to.be.an('array');",
                  "  pm.expect(rows.length).to.be.at.least(1);",
                  "});"
