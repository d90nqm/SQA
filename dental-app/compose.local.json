        "SPRING_DATASOURCE_PASSWORD": "${DENTAL_DB_PASSWORD:-password}",
        "SPRING_DATASOURCE_URL": "jdbc:postgresql://postgres:5432/appointment-service",
        "SPRING_DATASOURCE_USERNAME": "postgres",
        "SPRING_DATA_REDIS_HOST": "redis",
        "SPRING_DATA_REDIS_PORT": "6379",
        "JAVA_OPTS": "-Xms64m -Xmx256m -XX:ActiveProcessorCount=2",
        "DENTAL_JWT_PUBLIC_KEY": "${DENTAL_JWT_PUBLIC_KEY:-}"
      },
      "networks": {
        "microservice-network": null
      },
      "ports": [
        {
          "mode": "ingress",
          "target": 8082,
          "published": "8082",
          "protocol": "tcp",
          "host_ip": "127.0.0.1"
        }
      ],
      "restart": "unless-stopped",
      "mem_limit": "512m"
    },
