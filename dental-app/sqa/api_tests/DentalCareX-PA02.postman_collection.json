{
  "info": {
    "name": "DentalCareX - PA02 - Appointment and Redis Slot Lock",
    "description": "5_tool_test.xlsx: PA02_Testcase. Select the DentalCareX PA Local environment and run the collection in order with the local CheckDB helper.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// This collection writes test fixtures. Keep targets on this machine.",
          "for (const name of [\"baseUrl\", \"checkdbUrl\"]) {",
          "    const url = pm.environment.get(name) || \"\";",
          "    if (!/^http:\\/\\/(?:localhost|127\\.0\\.0\\.1):\\d+$/.test(url)) {",
          "        throw new Error(\"Select the DentalCareX PA Local environment and keep \" + name + \" on loopback.\");",
          "    }",
          "    pm.variables.set(name, url);",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "PA02 setup - create test fixtures",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "for (const name of [\"authToken\", \"actorId\", \"fixture\", \"appointmentId\", \"fixturePhone\", \"fixturePassword\"]) {",
              "        pm.variables.unset(name);",
              "    }",
              "    pm.variables.set(\"runId\", \"\");",
              "    pm.variables.set(\"bookingSetup\", JSON.stringify({kind: \"PA02\",",
              "        patientPhone: pm.environment.get(\"patientPassword\") ? pm.environment.get(\"patientPhone\") : \"\"",
              "    }));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const caseId = \"PA02 setup - create test fixtures\";",
              "function setCheck(name, assertion) { pm.test(caseId + \" | \" + name, assertion); }",
              "",
              "    setCheck(\"CheckDB fixture prepared (HTTP 200)\", () =>",
              "        pm.expect(pm.response.code, pm.response.text()).to.equal(200));",
              "    if (pm.response.code !== 200) {",
              "        pm.execution.setNextRequest(null);",
              "    } else {",
              "        const fixture = pm.response.json();",
              "        pm.variables.set(\"runId\", fixture.runId);",
              "        pm.variables.set(\"fixture\", JSON.stringify(fixture));",
              "        for (const [name, value] of Object.entries(fixture)) {",
              "            if (typeof value === \"string\") pm.variables.set(name, value);",
              "        }",
              "        const validMedicine = fixture.medicine && fixture.medicine.valid;",
              "        if (validMedicine) pm.variables.set(\"medicineId\", validMedicine.id);",
              "        if (fixture.histories) {",
              "            pm.variables.set(\"invalidHistoryId\", fixture.histories.insufficient.historyId);",
              "            pm.variables.set(\"validHistoryId\", fixture.histories.valid.historyId);",
              "        }",
              "    }"
            ]
          }
        }
      ],
