    {
      "name": "TC-P-05 - Create appointment",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Callback bridge works in both Postman Desktop and Newman.",
              "function send(request) {",
              "    return new Promise((resolve, reject) => {",
              "        pm.sendRequest(request, (error, response) => error ? reject(error) : resolve(response));",
              "    });",
              "}",
              "const pending = setInterval(() => {}, 500);",
              "(async () => {",
              "",
              "const f = JSON.parse(pm.variables.get(\"fixture\"));",
              "const slot = f.slots[\"create\"];",
              "pm.variables.set(\"bookingBody\", JSON.stringify({doctorId: f.doctorId, patientId: f.patientAId,",
              "    appointmentStartTime: slot, medicalServiceIds: [f.serviceId]}));",
              "",
              "    // Acquire the second slot before the timed POST. Postman measures only the create request.",
              "    const base = pm.environment.get(\"baseUrl\") + \"/appointment-service/appointments/slots/\";",
              "    const headers = {\"Content-Type\": \"application/json\", \"Authorization\": \"Bearer \" + pm.variables.get(\"authToken\")};",
              "    const body = {mode: \"raw\", raw: pm.variables.get(\"bookingBody\")};",
              "    for (const step of [\"release\", \"hold\"]) {",
              "        const response = await send({url: base + step, method: \"POST\", header: headers, body});",
              "        pm.test(\"TC-P-05 | precondition \" + step + \" returns 200\", () =>",
              "            pm.expect(response.code, response.text()).to.equal(200));",
              "        if (response.code !== 200) {",
              "            pm.execution.skipRequest();",
              "            break;",
              "        }",
              "    }",
              "",
              "})().catch(error => {",
              "    pm.test(pm.info.requestName + \" | Script completed\", () => { throw error; });",
              "    if (pm.info.eventName === \"prerequest\") pm.execution.skipRequest();",
              "}).finally(() => clearInterval(pending));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Callback bridge works in both Postman Desktop and Newman.",
              "function send(request) {",
              "    return new Promise((resolve, reject) => {",
              "        pm.sendRequest(request, (error, response) => error ? reject(error) : resolve(response));",
              "    });",
              "}",
              "const pending = setInterval(() => {}, 500);",
              "(async () => {",
              "// Excel Test Case ID: TC-P-05",
              "const caseId = \"TC-P-05\";",
              "",
              "// Invoke only a named CheckDB operation for this iteration's isolated fixtures.",
              "async function checkDB(path, label) {",
              "    const response = await send({",
              "        url: pm.environment.get(\"checkdbUrl\") + \"/v1/\" + path,",
              "        method: \"POST\",",
              "        header: {\"Content-Type\": \"application/json\", \"X-SQA-Key\": pm.environment.get(\"checkdbKey\")},",
              "        body: {mode: \"raw\", raw: JSON.stringify({runId: pm.variables.get(\"runId\"), label: label})}",
              "    });",
              "    if (response.code !== 200) throw new Error(\"CheckDB HTTP \" + response.code + \": \" + response.text());",
              "    return response.json();",
              "}",
              "function fixture() {",
              "    return JSON.parse(pm.variables.get(\"fixture\"));",
              "}",
              "function setCheck(name, assertion) {",
              "    pm.test(caseId + \" | \" + name, assertion);",
              "}",
              "async function checked(path, label, name, assertion) {",
              "    try {",
              "        const observed = await checkDB(path, label);",
              "        setCheck(name, () => assertion(observed));",
              "    } catch (error) {",
              "        setCheck(name, () => { throw error; });",
              "    }",
              "}",
              "setCheck(\"HTTP 201\", () => pm.expect([201]).to.include(pm.response.code));setCheck(\"Response time under 500 ms\", () => pm.expect(pm.response.responseTime).to.be.below(500));",
              "    const f = fixture();",
              "    const appointment = pm.response.code === 201 ? pm.response.json() : {};",
              "    if (/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(appointment.id || \"\")) pm.variables.set(\"appointmentId\", appointment.id);",
              "    setCheck(\"Created appointment matches the booking\", () => {",
              "        pm.expect(appointment.id).to.match(/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i);",
              "        pm.expect(appointment).to.include({doctorId: f.doctorId, patientId: f.patientAId, status: \"CONFIRMED\"});",
              "    });",
              "    await checked(\"booking\", \"create\", \"CheckDB | CONFIRMED appointment, selected service and released lock\", state => {",
              "        // Recover the dependent fixture ID from PostgreSQL even if the API body fails its assertions.",
              "        const row = state.rows.find(item => item.doctor_id === f.doctorId && item.patient_id === f.patientAId);",
              "        if (row && !pm.variables.get(\"appointmentId\")) pm.variables.set(\"appointmentId\", row.id);",
              "        pm.expect(state.rows).to.have.lengthOf(1);",
              "        pm.expect(row).to.include({id: appointment.id, status: \"CONFIRMED\"});",
              "        pm.expect(row.services).to.eql([f.serviceId]);",
              "        pm.expect(state.lock).to.equal(\"\");",
              "    });",
              "",
              "})().catch(error => {",
              "    pm.test(pm.info.requestName + \" | Script completed\", () => { throw error; });",
              "    if (pm.info.eventName === \"prerequest\") pm.execution.skipRequest();",
              "}).finally(() => clearInterval(pending));"
            ]
          }
        }
