    {
      "name": "TC-P-01 - Login (precondition)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const phone = pm.variables.get(\"fixturePhone\") || pm.environment.get(\"patientPhone\");",
              "    const password = pm.variables.get(\"fixturePassword\") || pm.environment.get(\"patientPassword\");",
              "    if (!phone || !password) {",
              "        throw new Error(\"Enter patientPhone and patientPassword in the selected environment.\");",
              "    }",
              "    pm.variables.set(\"loginBody\", JSON.stringify({phone, password}));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Excel Test Case ID: TC-P-01",
              "const caseId = \"TC-P-01\";",
              "function setCheck(name, assertion) { pm.test(caseId + \" | \" + name, assertion); }",
              "",
              "    const token = pm.response.headers.get(\"Authorization\");",
              "    const actor = pm.response.code === 200 ? pm.response.json() : null;",
              "    const id = actor && actor.id;",
              "    const expectedRole = \"PATIENT\";",
              "    const correctRole = actor && (actor.primaryRole === expectedRole ||",
              "        (Array.isArray(actor.roles) && actor.roles.includes(expectedRole)));",
              "    setCheck(\"HTTP 200\", () => pm.expect(pm.response.code).to.equal(200));",
              "    setCheck(\"JWT and actor ID returned\", () => {",
              "        pm.expect(token).to.match(/^(Bearer )?[^.]+\\.[^.]+\\.[^.]+$/i);",
              "        pm.expect(id).to.match(/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i);",
              "        pm.expect(correctRole, \"Expected role \" + expectedRole).to.equal(true);",
              "    });",
              "    const cleanNext = \"PA02 cleanup - verify fixture removal\";",
              "    if (token && /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(id || \"\") && correctRole) {",
              "        pm.variables.set(\"authToken\", token.replace(/^Bearer\\s+/i, \"\"));",
              "        pm.variables.set(\"actorId\", id);",
              "        if (id !== JSON.parse(pm.variables.get(\"fixture\")).patientAId) pm.execution.setNextRequest(cleanNext);",
              "    } else {",
              "        pm.execution.setNextRequest(cleanNext);",
              "    }"
            ]
          }
        }
      ],
