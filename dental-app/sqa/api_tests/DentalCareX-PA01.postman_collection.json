    {
      "name": "TC_API_005 - Verify insufficient-stock outcome",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Callback bridge works in both Postman Desktop and Newman.",
              "function send(request) {",
              "    return new Promise((resolve, reject) => {",
              "        pm.sendRequest(request, (error, response) => error ? reject(error) : resolve(response));",
              "    });",
              "}",
              "const pending = setInterval(() => {}, 500);",
              "(async () => {",
              "",
              "    // Gate the read on observable processing. NONE on its own could just mean the Saga has not started.",
              "    const deadline = Date.now() + 25000;",
              "    pm.variables.set(\"negativeEvidence\", \"false\");",
              "    if (pm.variables.get(\"negativePrescriptionId\")) {",
              "        do {",
              "            const response = await send({",
              "                url: pm.environment.get(\"checkdbUrl\") + \"/v1/rx\", method: \"POST\",",
              "                header: {\"Content-Type\": \"application/json\", \"X-SQA-Key\": pm.environment.get(\"checkdbKey\")},",
              "                body: {mode: \"raw\", raw: JSON.stringify({runId: pm.variables.get(\"runId\"), label: \"insufficient\"})}",
              "            });",
              "            if (response.code !== 200) break;",
              "            const observed = response.json();",
              "            if (observed.insufficientStockLogged || observed.orders.some(order =>",
              "                order.prescription === pm.variables.get(\"negativePrescriptionId\") &&",
              "                [\"CANCELLED\", \"FAILED\"].includes(order.status))) {",
              "                pm.variables.set(\"negativeEvidence\", \"true\");",
              "                break;",
              "            }",
              "            await new Promise(resolve => setTimeout(resolve, 900));",
              "        } while (Date.now() < deadline);",
              "    }",
              "",
              "})().catch(error => {",
              "    pm.test(pm.info.requestName + \" | Script completed\", () => { throw error; });",
              "    if (pm.info.eventName === \"prerequest\") pm.execution.skipRequest();",
              "}).finally(() => clearInterval(pending));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Callback bridge works in both Postman Desktop and Newman.",
              "function send(request) {",
              "    return new Promise((resolve, reject) => {",
              "        pm.sendRequest(request, (error, response) => error ? reject(error) : resolve(response));",
              "    });",
              "}",
              "const pending = setInterval(() => {}, 500);",
              "(async () => {",
              "// Excel Test Case ID: TC_API_005",
              "const caseId = \"TC_API_005\";",
              "",
              "// Invoke only a named CheckDB operation for this iteration's isolated fixtures.",
              "async function checkDB(path, label) {",
              "    const response = await send({",
              "        url: pm.environment.get(\"checkdbUrl\") + \"/v1/\" + path,",
              "        method: \"POST\",",
              "        header: {\"Content-Type\": \"application/json\", \"X-SQA-Key\": pm.environment.get(\"checkdbKey\")},",
              "        body: {mode: \"raw\", raw: JSON.stringify({runId: pm.variables.get(\"runId\"), label: label})}",
              "    });",
              "    if (response.code !== 200) throw new Error(\"CheckDB HTTP \" + response.code + \": \" + response.text());",
              "    return response.json();",
              "}",
              "function fixture() {",
              "    return JSON.parse(pm.variables.get(\"fixture\"));",
              "}",
              "function setCheck(name, assertion) {",
              "    pm.test(caseId + \" | \" + name, assertion);",
              "}",
              "async function checked(path, label, name, assertion) {",
              "    try {",
              "        const observed = await checkDB(path, label);",
              "        setCheck(name, () => assertion(observed));",
              "    } catch (error) {",
              "        setCheck(name, () => { throw error; });",
              "    }",
              "}",
              "setCheck(\"HTTP 200\", () => pm.expect([200]).to.include(pm.response.code));",
              "    setCheck(\"HTTP body reports CANCELLED, FAILED or NONE after processing\", () => {",
              "        pm.expect(pm.variables.get(\"negativeEvidence\"), \"No evidence of processing the insufficient-stock request\").to.equal(\"true\");",
              "        pm.expect([\"CANCELLED\", \"FAILED\", \"NONE\"]).to.include(pm.response.json().status);",
              "    });",
              "    await checked(\"rx\", \"insufficient\", \"CheckDB | no active order, stock charge or medicine fee\", state => {",
              "        pm.expect(state.orders.every(order => [\"CANCELLED\", \"FAILED\"].includes(order.status))).to.equal(true);",
              "        pm.expect(state.lots.map(lot => lot.quantity_on_hand)).to.eql([4, 4]);",
              "        pm.expect(state.invoiceItems).to.eql([]);",
              "        pm.expect(state.ledgerCount).to.equal(0);",
              "    });",
              "",
              "})().catch(error => {",
              "    pm.test(pm.info.requestName + \" | Script completed\", () => { throw error; });",
              "    if (pm.info.eventName === \"prerequest\") pm.execution.skipRequest();",
              "}).finally(() => clearInterval(pending));"
            ]
          }
        }
