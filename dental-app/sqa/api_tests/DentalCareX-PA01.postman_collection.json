{
  "info": {
    "name": "DentalCareX - PA01 - Prescription, Inventory and Saga",
    "description": "5_tool_test.xlsx: PA01_Testcase. Select the DentalCareX PA Local environment and run the collection in order with the local CheckDB helper.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// This collection writes test fixtures. Keep targets on this machine.",
          "for (const name of [\"baseUrl\", \"checkdbUrl\"]) {",
          "    const url = pm.environment.get(name) || \"\";",
          "    if (!/^http:\\/\\/(?:localhost|127\\.0\\.0\\.1):\\d+$/.test(url)) {",
          "        throw new Error(\"Select the DentalCareX PA Local environment and keep \" + name + \" on loopback.\");",
          "    }",
          "    pm.variables.set(name, url);",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "TC_API_001 - Login",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "for (const name of [\"authToken\", \"actorId\", \"fixture\", \"dispenseOrderId\", \"negativePrescriptionId\"]) {",
              "        pm.variables.unset(name);",
              "    }",
              "    pm.variables.set(\"runId\", \"\");",
              "",
              "    const phone = pm.variables.get(\"fixturePhone\") || pm.environment.get(\"doctorPhone\");",
              "    const password = pm.variables.get(\"fixturePassword\") || pm.environment.get(\"doctorPassword\");",
              "    if (!phone || !password) {",
              "        throw new Error(\"Enter doctorPhone and doctorPassword in the selected environment.\");",
              "    }",
              "    pm.variables.set(\"loginBody\", JSON.stringify({phone, password}));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Excel Test Case ID: TC_API_001",
              "const caseId = \"TC_API_001\";",
              "function setCheck(name, assertion) { pm.test(caseId + \" | \" + name, assertion); }",
              "",
              "    const token = pm.response.headers.get(\"Authorization\");",
              "    const actor = pm.response.code === 200 ? pm.response.json() : null;",
              "    const id = actor && actor.id;",
              "    const expectedRole = \"DOCTOR\";",
              "    const correctRole = actor && (actor.primaryRole === expectedRole ||",
              "        (Array.isArray(actor.roles) && actor.roles.includes(expectedRole)));",
              "    setCheck(\"HTTP 200\", () => pm.expect(pm.response.code).to.equal(200));",
              "    setCheck(\"JWT and actor ID returned\", () => {",
              "        pm.expect(token).to.match(/^(Bearer )?[^.]+\\.[^.]+\\.[^.]+$/i);",
              "        pm.expect(id).to.match(/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i);",
              "        pm.expect(correctRole, \"Expected role \" + expectedRole).to.equal(true);",
              "    });",
              "    const cleanNext = null;",
              "    if (token && /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(id || \"\") && correctRole) {",
              "        pm.variables.set(\"authToken\", token.replace(/^Bearer\\s+/i, \"\"));",
              "        pm.variables.set(\"actorId\", id);",
              "        ",
              "    } else {",
              "        pm.execution.setNextRequest(cleanNext);",
              "    }"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/user-service/users/login",
        "description": "",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{{loginBody}}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "PA01 setup - create test fixtures",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const caseId = \"PA01 setup - create test fixtures\";",
              "function setCheck(name, assertion) { pm.test(caseId + \" | \" + name, assertion); }",
              "",
              "    setCheck(\"CheckDB fixture prepared (HTTP 200)\", () =>",
              "        pm.expect(pm.response.code, pm.response.text()).to.equal(200));",
              "    if (pm.response.code !== 200) {",
              "        pm.execution.setNextRequest(null);",
              "    } else {",
              "        const fixture = pm.response.json();",
              "        pm.variables.set(\"runId\", fixture.runId);",
              "        pm.variables.set(\"fixture\", JSON.stringify(fixture));",
              "        for (const [name, value] of Object.entries(fixture)) {",
              "            if (typeof value === \"string\") pm.variables.set(name, value);",
              "        }",
              "        const validMedicine = fixture.medicine && fixture.medicine.valid;",
              "        if (validMedicine) pm.variables.set(\"medicineId\", validMedicine.id);",
              "        if (fixture.histories) {",
              "            pm.variables.set(\"invalidHistoryId\", fixture.histories.insufficient.historyId);",
              "            pm.variables.set(\"validHistoryId\", fixture.histories.valid.historyId);",
              "        }",
              "    }"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-SQA-Key",
            "value": "{{checkdbKey}}"
