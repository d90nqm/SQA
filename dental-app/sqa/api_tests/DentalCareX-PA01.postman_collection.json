    {
      "name": "TC_API_002 - Create valid prescription",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const f = JSON.parse(pm.variables.get(\"fixture\"));",
              "const label = \"valid\";",
              "const {appointmentId, historyId} = f.histories[label];",
              "const {id, name} = f.medicine[label];",
              "pm.variables.set(\"rxBody\", JSON.stringify({",
              "    appointmentId, medicalHistoryId: historyId, doctorId: f.doctorId, patientId: f.patientId,",
              "    items: [{id: pm.variables.replaceIn(\"{{$guid}}\"), medicineId: id, name, quantity: 5,",
              "        unitPrice: 1000, unit: \"tablet\", dosage: \"1 tablet\", frequency: \"Daily\",",
              "        duration: \"5 days\", instruction: \"SQA API fixture\"}]",
              "}));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Callback bridge works in both Postman Desktop and Newman.",
              "function send(request) {",
              "    return new Promise((resolve, reject) => {",
              "        pm.sendRequest(request, (error, response) => error ? reject(error) : resolve(response));",
              "    });",
              "}",
              "const pending = setInterval(() => {}, 500);",
              "(async () => {",
              "// Excel Test Case ID: TC_API_002",
              "const caseId = \"TC_API_002\";",
              "",
              "// Invoke only a named CheckDB operation for this iteration's isolated fixtures.",
              "async function checkDB(path, label) {",
              "    const response = await send({",
              "        url: pm.environment.get(\"checkdbUrl\") + \"/v1/\" + path,",
              "        method: \"POST\",",
              "        header: {\"Content-Type\": \"application/json\", \"X-SQA-Key\": pm.environment.get(\"checkdbKey\")},",
              "        body: {mode: \"raw\", raw: JSON.stringify({runId: pm.variables.get(\"runId\"), label: label})}",
              "    });",
              "    if (response.code !== 200) throw new Error(\"CheckDB HTTP \" + response.code + \": \" + response.text());",
              "    return response.json();",
              "}",
              "function fixture() {",
              "    return JSON.parse(pm.variables.get(\"fixture\"));",
              "}",
              "function setCheck(name, assertion) {",
              "    pm.test(caseId + \" | \" + name, assertion);",
              "}",
              "async function checked(path, label, name, assertion) {",
              "    try {",
              "        const observed = await checkDB(path, label);",
              "        setCheck(name, () => assertion(observed));",
              "    } catch (error) {",
              "        setCheck(name, () => { throw error; });",
              "    }",
              "}",
              "setCheck(\"HTTP 202\", () => pm.expect([202]).to.include(pm.response.code));",
              "    const prescriptionId = pm.response.code === 202 ? pm.response.json().id : null;",
              "    setCheck(\"Tracking ID returned\", () => pm.expect(prescriptionId).to.match(/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i));",
              "    if (prescriptionId) {",
              "        // Wait for committed downstream effects. A response of 202 is only acknowledgment.",
              "        try {",
              "            const deadline = Date.now() + 30000;",
              "            let state;",
              "            do {",
              "                state = await checkDB(\"rx\", \"valid\");",
              "                const released = state.orders.some(order =>",
              "                    order.prescription === prescriptionId && order.status === \"RELEASED\");",
              "                if (released && state.invoiceItems.length > 0 && state.ledgerCount > 0) break;",
              "                await new Promise(resolve => setTimeout(resolve, 900));",
              "            } while (Date.now() < deadline);",
              "            setCheck(\"CheckDB | matching order reached RELEASED\", () => {",
              "                pm.expect(state.orders).to.have.lengthOf(1);",
              "                pm.expect(state.orders[0]).to.include({",
              "                    prescription: prescriptionId, status: \"RELEASED\", doctor_id: fixture().doctorId",
              "                });",
              "            });",
              "            setCheck(\"CheckDB | stock, ledger and invoice reflect five units\", () => {",
              "                pm.expect(state.lots.map(lot => lot.quantity_on_hand)).to.eql([7, 12]);",
              "                pm.expect(state.ledgerCount).to.be.greaterThan(0);",
              "                pm.expect(state.invoiceItems).to.deep.include({",
              "                    reference_id: fixture().medicine.valid.id, quantity: 5, unit_price: 1000",
              "                });",
              "            });",
              "        } catch (error) {",
              "            setCheck(\"CheckDB | await Saga\", () => { throw error; });",
              "        }",
              "    }",
              "",
              "})().catch(error => {",
              "    pm.test(pm.info.requestName + \" | Script completed\", () => { throw error; });",
              "    if (pm.info.eventName === \"prerequest\") pm.execution.skipRequest();",
              "}).finally(() => clearInterval(pending));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{authToken}}"
