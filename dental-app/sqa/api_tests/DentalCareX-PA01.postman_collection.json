    {
      "name": "TC_API_003 - FEFO allocation",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Callback bridge works in both Postman Desktop and Newman.",
              "function send(request) {",
              "    return new Promise((resolve, reject) => {",
              "        pm.sendRequest(request, (error, response) => error ? reject(error) : resolve(response));",
              "    });",
              "}",
              "const pending = setInterval(() => {}, 500);",
              "(async () => {",
              "",
              "    // Capture the database before this read-only test so the comparison is independent of TC_API_002.",
              "    const response = await send({",
              "        url: pm.environment.get(\"checkdbUrl\") + \"/v1/rx\", method: \"POST\",",
              "        header: {\"Content-Type\": \"application/json\", \"X-SQA-Key\": pm.environment.get(\"checkdbKey\")},",
              "        body: {mode: \"raw\", raw: JSON.stringify({runId: pm.variables.get(\"runId\"), label: \"valid\"})}",
              "    });",
