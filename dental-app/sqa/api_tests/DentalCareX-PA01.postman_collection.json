              "",
              "})().catch(error => {",
              "    pm.test(pm.info.requestName + \" | Script completed\", () => { throw error; });",
              "    if (pm.info.eventName === \"prerequest\") pm.execution.skipRequest();",
              "}).finally(() => clearInterval(pending));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Callback bridge works in both Postman Desktop and Newman.",
              "function send(request) {",
              "    return new Promise((resolve, reject) => {",
              "        pm.sendRequest(request, (error, response) => error ? reject(error) : resolve(response));",
              "    });",
              "}",
              "const pending = setInterval(() => {}, 500);",
              "(async () => {",
              "// Excel Test Case ID: TC_API_003",
              "const caseId = \"TC_API_003\";",
              "",
              "// Invoke only a named CheckDB operation for this iteration's isolated fixtures.",
              "async function checkDB(path, label) {",
              "    const response = await send({",
              "        url: pm.environment.get(\"checkdbUrl\") + \"/v1/\" + path,",
              "        method: \"POST\",",
              "        header: {\"Content-Type\": \"application/json\", \"X-SQA-Key\": pm.environment.get(\"checkdbKey\")},",
              "        body: {mode: \"raw\", raw: JSON.stringify({runId: pm.variables.get(\"runId\"), label: label})}",
              "    });",
              "    if (response.code !== 200) throw new Error(\"CheckDB HTTP \" + response.code + \": \" + response.text());",
              "    return response.json();",
              "}",
              "function fixture() {",
              "    return JSON.parse(pm.variables.get(\"fixture\"));",
              "}",
              "function setCheck(name, assertion) {",
              "    pm.test(caseId + \" | \" + name, assertion);",
              "}",
              "async function checked(path, label, name, assertion) {",
              "    try {",
              "        const observed = await checkDB(path, label);",
              "        setCheck(name, () => assertion(observed));",
              "    } catch (error) {",
              "        setCheck(name, () => { throw error; });",
              "    }",
              "}",
              "setCheck(\"HTTP 200\", () => pm.expect([200]).to.include(pm.response.code));",
              "    if (pm.response.code === 200) {",
              "        setCheck(\"Returns available lots in ascending expiration order\", () => {",
              "            const data = pm.response.json();",
              "            const lots = Array.isArray(data) ? data : data.lots;",
              "            pm.expect(lots).to.be.an(\"array\").that.is.not.empty;",
              "            const dates = lots.map(lot => lot.expireDate || lot.expirationDate);",
              "            dates.forEach(date => pm.expect(Number.isFinite(Date.parse(date))).to.equal(true));",
              "            pm.expect(dates.map(Date.parse)).to.eql(dates.map(Date.parse).sort((a, b) => a - b));",
              "        });",
              "    }",
              "    await checked(\"rx\", \"valid\", \"CheckDB | read-only FEFO leaves stock intact\", state => {",
              "        pm.expect(pm.variables.get(\"fefoBefore\"), \"Missing database snapshot\").to.be.ok;",
              "        const before = JSON.parse(pm.variables.get(\"fefoBefore\"));",
              "        pm.expect(state.lots).to.eql(before.lots);",
              "        pm.expect(state.ledgerCount).to.equal(before.ledgerCount);",
              "    });",
              "",
              "})().catch(error => {",
              "    pm.test(pm.info.requestName + \" | Script completed\", () => { throw error; });",
              "    if (pm.info.eventName === \"prerequest\") pm.execution.skipRequest();",
              "}).finally(() => clearInterval(pending));"
            ]
          }
        }
      ],
      "request": {
