    {
      "name": "TC_API_006 - Find dispense order",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Callback bridge works in both Postman Desktop and Newman.",
              "function send(request) {",
              "    return new Promise((resolve, reject) => {",
              "        pm.sendRequest(request, (error, response) => error ? reject(error) : resolve(response));",
              "    });",
              "}",
              "const pending = setInterval(() => {}, 500);",
              "(async () => {",
              "// Excel Test Case ID: TC_API_006",
              "const caseId = \"TC_API_006\";",
              "",
              "// Invoke only a named CheckDB operation for this iteration's isolated fixtures.",
              "async function checkDB(path, label) {",
              "    const response = await send({",
              "        url: pm.environment.get(\"checkdbUrl\") + \"/v1/\" + path,",
              "        method: \"POST\",",
              "        header: {\"Content-Type\": \"application/json\", \"X-SQA-Key\": pm.environment.get(\"checkdbKey\")},",
              "        body: {mode: \"raw\", raw: JSON.stringify({runId: pm.variables.get(\"runId\"), label: label})}",
              "    });",
              "    if (response.code !== 200) throw new Error(\"CheckDB HTTP \" + response.code + \": \" + response.text());",
              "    return response.json();",
              "}",
              "function fixture() {",
              "    return JSON.parse(pm.variables.get(\"fixture\"));",
              "}",
              "function setCheck(name, assertion) {",
              "    pm.test(caseId + \" | \" + name, assertion);",
              "}",
              "async function checked(path, label, name, assertion) {",
              "    try {",
              "        const observed = await checkDB(path, label);",
              "        setCheck(name, () => assertion(observed));",
              "    } catch (error) {",
              "        setCheck(name, () => { throw error; });",
              "    }",
              "}",
              "setCheck(\"HTTP 200 or 404\", () => pm.expect([200, 404]).to.include(pm.response.code));",
              "    const body = pm.response.code === 200 ? pm.response.json() : null;",
              "    if (body && /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(body.id) && body.medicalHistoryId === fixture().histories.valid.historyId) {",
              "        pm.variables.set(\"dispenseOrderId\", body.id);",
              "    }",
              "    await checked(\"rx\", \"valid\", \"CheckDB | lookup matches the fixture's order\", state => {",
              "        if (pm.response.code === 404) {",
              "            pm.expect(state.orders.filter(order => order.status !== \"CANCELED\")).to.eql([]);",
              "        } else {",
              "            pm.expect(body.medicalHistoryId).to.equal(fixture().histories.valid.historyId);",
              "            pm.expect(state.orders.map(order => order.id)).to.include(body.id);",
              "        }",
              "    });",
              "",
              "})().catch(error => {",
              "    pm.test(pm.info.requestName + \" | Script completed\", () => { throw error; });",
              "    if (pm.info.eventName === \"prerequest\") pm.execution.skipRequest();",
              "}).finally(() => clearInterval(pending));"
            ]
          }
        }
      ],
